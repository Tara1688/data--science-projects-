        "# Q1: Echo program\n",
        "# Reads a file line by line and writes each line to echo.txt\n",
        "\n",
        "filename = input(\"Enter the name of the file to read: \")\n",
        "\n",
        "try:\n",
        "    with open(filename, \"r\") as infile, open(\"echo.txt\", \"w\") as outfile:\n",
        "        for line in infile:\n",
        "            outfile.write(line)\n",
        "    print(\"Finished writing to echo.txt\")\n",
        "\n",
        "except FileNotFoundError:\n",
        "    print(\"Error: The file you entered does not exist.\")\n"
