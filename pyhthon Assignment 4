        "    exit()\n",
        "\n",
        "number_str, unit_str = parts\n",
        "\n",
        "# Validate number\n",
        "try:\n",
        "    value = float(number_str)\n",
        "except:\n",
        "    print(\"Error: The first part must be a valid number.\")\n",
        "    exit()\n",
        "\n",
        "# Validate unit\n",
        "unit = unit_str[0].upper()\n",
        "\n",
        "if unit not in (\"M\", \"F\"):\n",
        "    print(\"Error: Unit must start with M (meters) or F (feet).\")\n",
        "    exit()\n",
        "\n",
        "# Conversion\n",
        "METERS_TO_FEET = 3.28084\n",
        "\n",
        "if unit == \"M\":\n",
        "    result = value * METERS_TO_FEET\n",
        "    print(f\"{value} meters is {result:.4f} feet\")\n",
        "else:\n",
        "    result = value / METERS_TO_FEET\n",
        "    print(f\"{value} feet is {result:.4f} meters\")\n"
