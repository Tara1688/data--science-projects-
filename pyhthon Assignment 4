        "\n",
        "def process_file(filename):\n",
        "    highest_average = 0\n",
        "    best_batch = \"\"\n",
        "\n",
        "    with open(filename, \"r\") as file:\n",
        "        for line in file:\n",
        "            line = line.strip()\n",
        "            if not line:\n",
        "                continue  # skip empty lines\n",
        "\n",
        "            # Split batch name from numbers\n",
        "            batch_name, numbers = line.split(\":\")\n",
        "            batch_name = batch_name.strip()\n",
        "            values = numbers.split(\",\")\n",
        "\n",
        "            # Convert values to floats with error handling\n",
        "            valid_numbers = []\n",
        "\n",
        "            for v in values:\n",
        "                v = v.strip()\n",
        "                try:\n",
        "                    num = float(v)\n",
        "                    valid_numbers.append(num)\n",
        "                except:\n",
        "                    print(f\"Non-numeric value skipped in {batch_name}: {v}\")\n",
        "\n",
        "            # If no valid numeric values, skip the batch\n",
        "            if len(valid_numbers) == 0:\n",
        "                print(f\"Batch {batch_name} skipped — no valid numeric data\")\n",
        "                continue\n",
        "\n",
        "            # Compute the average for this batch\n",
        "            avg = sum(valid_numbers) / len(valid_numbers)\n",
        "\n",
        "            # Check if this is the highest average so far\n",
        "            if avg > highest_average:\n",
        "                highest_average = avg\n",
        "                best_batch = batch_name\n",
        "\n",
        "    return best_batch, highest_average\n",
        "\n",
        "\n",
        "def main():\n",
        "    filename = input(\"Enter the filename: \")\n",
        "    best_batch, highest_average = process_file(filename)\n",
        "    print(f\"\\nBatch with highest average weight: {best_batch}\")\n",
        "    print(f\"Highest average weight: {highest_average:.2f}\")\n",
        "\n",
        "\n",
        "main()\n"
      ],
