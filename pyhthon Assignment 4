        "filename = input(\"Enter transaction filename: \").strip()\n",
        "\n",
        "# Try to open the file\n",
        "try:\n",
        "    file = open(filename, \"r\")\n",
        "except:\n",
        "    print(\"Error: Cannot open file.\")\n",
        "    exit()\n",
        "\n",
        "totals = {}   # dictionary to store total sales per product\n",
        "\n",
        "for line in file:\n",
        "    parts = line.split()\n",
        "\n",
        "    # Each valid line must have exactly 6 fields\n",
        "    if len(parts) != 6:\n",
        "        print(\"Skipping invalid line:\", line.strip())\n",
        "        continue\n",
        "\n",
        "    trans_id, date, product_id, cust_id, units_str, price_str = parts\n",
        "\n",
        "    # Convert units and price\n",
        "    try:\n",
        "        units = int(units_str)\n",
        "        price = float(price_str)\n",
        "    except:\n",
        "        print(\"Skipping line with invalid numbers:\", line.strip())\n",
        "        continue\n",
        "\n",
        "    # Compute sale amount\n",
        "    sale_amount = units * price\n",
        "\n",
        "    # Add to product total\n",
        "    if product_id not in totals:\n",
        "        totals[product_id] = 0\n",
        "\n",
        "    totals[product_id] += sale_amount\n",
        "\n",
        "file.close()\n",
        "\n",
        "# Display results\n",
        "print(\"\\nTotal Sales by Product:\")\n",
        "for pid, total in totals.items():\n",
        "    print(f\"{pid}: ${total:.2f}\")\n"
