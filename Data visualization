        "import pandas as pd\n",
        "\n",
        "def load_division(path):\n",
        "    # Load raw file\n",
        "    raw = pd.read_csv(path, header=None)\n",
        "\n",
        "    # Find the row where the real table starts (row containing \"CODE\")\n",
        "    start = raw[raw[0] == \"CODE\"].index[0]\n",
        "\n",
        "    # Load again starting from that row\n",
        "    df = pd.read_csv(path, skiprows=start)\n",
        "\n",
        "    # Drop empty columns\n",
        "    df = df.dropna(axis=1, how=\"all\")\n",
        "\n",
        "    # Rename columns\n",
        "    df.columns = [\"CODE\", \"Description\", \"Act2019\", \"Act2020\", \"Proj2021\"]\n",
        "\n",
        "    return df\n",
        "\n",
        "divA = load_division(\"/content/incstmt-diva-assum(1).csv\")\n",
